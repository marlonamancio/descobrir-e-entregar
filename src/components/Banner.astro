---
/**
 * Faixa global: no Starlight, `banner` é campo de frontmatter por página.
 * Este override mostra a faixa de alpha em todas as páginas e mantém,
 * abaixo dela, o banner próprio da página, se houver.
 */
import Default from '@astrojs/starlight/components/Banner.astro';
---

<div class="sl-banner faixa-alpha" data-pagefind-ignore>
	Versão alpha: o livro está em construção e aceita contribuições.{' '}
	<a href="/como-contribuir/">Saiba como contribuir</a>.
</div>
<Default />

<style>
	.faixa-alpha {
		padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
		background-color: var(--sl-color-banner-bg);
		color: var(--sl-color-banner-text);
		line-height: var(--sl-line-height-headings);
		text-align: center;
		text-wrap: balance;
		box-shadow: var(--sl-shadow-sm);
	}
	.faixa-alpha a {
		color: var(--sl-color-banner-text);
	}
</style>
