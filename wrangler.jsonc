// Publicação do site estático do Astro nos Cloudflare Workers (assets estáticos).
{
  "name": "descobrir-e-entregar",
  "compatibility_date": "2026-11-23",
  "assets": {
    "directory": "./dist",
    // Endereço inexistente mostra a 404 gerada pelo build (dist/404.html).
    "not_found_handling": "404-page"
  }
}
